# Variables d'environnement — AIMH Phase 1
# Copiez ce fichier en .env.local et remplissez vos valeurs Supabase
# Récupérées depuis : https://supabase.com/dashboard → votre projet → Settings → API

# URL du projet Supabase (ex: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE_PROJET.supabase.co

# Clé publique Supabase (anon / public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_anon_key_ici

# URL du site — utilisée pour les redirections d'authentification (magic link, reset password)
# En développement : http://localhost:3000
# En production : https://votre-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
