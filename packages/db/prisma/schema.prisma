generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum OrganizationPlan {
  starter
  pro
  enterprise
}

enum OrganizationMemberRole {
  owner
  member
}

enum AgentType {
  creative_studio
  website_builder
  voiceover
  paid_media
  // Phase 2a – Family C: Web & E-commerce
  website_multilang
  funnel_builder
  agency_delivery
  shop_builder
  ecommerce_growth
  // Phase 2a – Family D: Social Media
  social_automation
  facebook_growth
  social_engagement
  social_monetization
  // Phase 2a – Family E: Ads & CRM
  ads_warrior
  crm_loyalty
  // Phase 2a – Family H: Membership & Local
  membership_builder
  local_growth
}

enum ProjectStatus {
  draft
  active
  paused
  completed
  archived
}

enum BriefStatus {
  submitted
  parsed
  needs_clarification
  approved
  archived
}

enum ClientMemoryType {
  fact
  preference
  constraint
  approved_copy
  approved_visual
}

enum JobStatus {
  queued
  running
  completed
  failed
  canceled
}

enum JobStepStatus {
  pending
  running
  completed
  failed
  skipped
}

enum AssetType {
  image
  audio
  document
  archive
  code_bundle
  preview
  // Phase 2a additions
  video
  music
  spreadsheet
  delivery_pack
}

model User {
  id               String               @id @db.Uuid
  email            String               @unique
  fullName         String?              @map("full_name")
  createdAt        DateTime             @default(now()) @map("created_at")
  lastLoginAt      DateTime?            @map("last_login_at")
  organizationLinks OrganizationMember[]
  createdProjects  Project[]            @relation("ProjectCreator")

  @@map("users")
}

model Organization {
  id                 String                @id @default(uuid()) @db.Uuid
  name               String
  slug               String                @unique
  plan               OrganizationPlan      @default(starter)
  createdAt          DateTime              @default(now()) @map("created_at")
  brands             Brand[]
  projects           Project[]
  members            OrganizationMember[]
  usageEvents        UsageEvent[]
  clientMemoryEntries ClientMemoryEntry[]
  assets             Asset[]

  @@map("organizations")
}

model OrganizationMember {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  role           OrganizationMemberRole @default(member)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Brand {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @map("organization_id") @db.Uuid
  name                String
  websiteUrl          String?               @map("website_url")
  industry            String?
  targetAudience      String?               @map("target_audience")
  toneOfVoice         String?               @map("tone_of_voice")
  brandGuidelinesJson Json?                 @map("brand_guidelines_json")
  createdAt           DateTime              @default(now()) @map("created_at")
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects            Project[]
  clientMemoryEntries ClientMemoryEntry[]

  @@map("brands")
}

model Project {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  brandId         String?        @map("brand_id") @db.Uuid
  agentType       AgentType      @map("agent_type")
  title           String
  status          ProjectStatus  @default(draft)
  createdByUserId String         @map("created_by_user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand           Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  createdByUser   User           @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  briefs          Brief[]
  jobs            Job[]
  assets          Asset[]
  deliveries      Delivery[]
  qaReports       QaReport[]
  usageEvents     UsageEvent[]
  socialCalendars SocialCalendar[]
  productCatalogs ProductCatalog[]
  membershipPlans MembershipPlan[]

  @@index([organizationId, status])
  @@map("projects")
}

model Brief {
  id              String      @id @default(uuid()) @db.Uuid
  projectId       String      @map("project_id") @db.Uuid
  rawInputText    String      @map("raw_input_text")
  attachmentsJson Json?       @map("attachments_json")
  parsedBriefJson Json?       @map("parsed_brief_json")
  status          BriefStatus @default(submitted)
  createdAt       DateTime    @default(now()) @map("created_at")
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobs            Job[]

  @@index([projectId, status])
  @@map("briefs")
}

model ClientMemoryEntry {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  brandId        String?          @map("brand_id") @db.Uuid
  memoryType     ClientMemoryType @map("memory_type")
  key            String
  valueJson      Json             @map("value_json")
  source         String?
  confidenceScore Decimal?        @map("confidence_score") @db.Decimal(5, 4)
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand          Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([organizationId, memoryType])
  @@map("client_memory_entries")
}

model Job {
  id            String      @id @default(uuid()) @db.Uuid
  projectId     String      @map("project_id") @db.Uuid
  briefId       String?     @map("brief_id") @db.Uuid
  jobType       String      @map("job_type")
  status        JobStatus   @default(queued)
  priority      Int         @default(0)
  attemptCount  Int         @default(0) @map("attempt_count")
  queuedAt      DateTime    @default(now()) @map("queued_at")
  startedAt     DateTime?   @map("started_at")
  finishedAt    DateTime?   @map("finished_at")
  errorMessage  String?     @map("error_message")
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  brief         Brief?      @relation(fields: [briefId], references: [id], onDelete: SetNull)
  jobSteps      JobStep[]
  agentRuns     AgentRun[]
  assets        Asset[]
  deliveries    Delivery[]
  qaReports     QaReport[]
  usageEvents   UsageEvent[]

  @@index([projectId, status])
  @@map("jobs")
}

model JobStep {
  id         String        @id @default(uuid()) @db.Uuid
  jobId       String       @map("job_id") @db.Uuid
  stepName    String       @map("step_name")
  stepOrder   Int          @map("step_order")
  status      JobStepStatus @default(pending)
  inputJson   Json?        @map("input_json")
  outputJson  Json?        @map("output_json")
  startedAt   DateTime?    @map("started_at")
  finishedAt  DateTime?    @map("finished_at")
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, stepOrder])
  @@map("job_steps")
}

model AgentRun {
  id               String    @id @default(uuid()) @db.Uuid
  jobId            String    @map("job_id") @db.Uuid
  agentType        AgentType @map("agent_type")
  modelProvider    String    @map("model_provider")
  modelName        String    @map("model_name")
  inputTokens      Int?      @map("input_tokens")
  outputTokens     Int?      @map("output_tokens")
  estimatedCostUsd Decimal?  @map("estimated_cost_usd") @db.Decimal(10, 4)
  status           JobStatus @default(queued)
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  job              Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, agentType])
  @@map("agent_runs")
}

model Asset {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  jobId          String?      @map("job_id") @db.Uuid
  assetType      AssetType    @map("asset_type")
  storageBucket  String       @map("storage_bucket")
  storagePath    String       @map("storage_path")
  mimeType       String       @map("mime_type")
  sizeBytes      BigInt?      @map("size_bytes")
  metadataJson   Json?        @map("metadata_json")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job            Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([projectId, assetType])
  @@map("assets")
}

model Delivery {
  id           String    @id @default(uuid()) @db.Uuid
  projectId     String   @map("project_id") @db.Uuid
  jobId         String?  @map("job_id") @db.Uuid
  deliveryType  String   @map("delivery_type")
  summaryText   String?  @map("summary_text")
  status        String
  deliveredAt   DateTime? @map("delivered_at")
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job           Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@map("deliveries")
}

model QaReport {
  id          String    @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  jobId        String?  @map("job_id") @db.Uuid
  score        Decimal? @db.Decimal(5, 2)
  checksJson   Json?    @map("checks_json")
  issuesJson   Json?    @map("issues_json")
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job          Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@map("qa_reports")
}

model UsageEvent {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  projectId        String?      @map("project_id") @db.Uuid
  jobId            String?      @map("job_id") @db.Uuid
  provider         String
  metricType       String       @map("metric_type")
  quantity         Decimal      @db.Decimal(12, 4)
  estimatedCostUsd Decimal?     @map("estimated_cost_usd") @db.Decimal(10, 4)
  metadataJson     Json?        @map("metadata_json")
  createdAt        DateTime     @default(now()) @map("created_at")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  job              Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([organizationId, provider])
  @@map("usage_events")
}

// ─── Phase 2a Models ──────────────────────────────────────────────────────────

model SocialCalendar {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  jobId          String?  @map("job_id") @db.Uuid
  month          Int
  year           Int
  platform       String
  postsJson      Json     @map("posts_json")
  hashtagsJson   Json?    @map("hashtags_json")
  createdAt      DateTime @default(now()) @map("created_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("social_calendars")
}

model ProductCatalog {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  jobId          String?  @map("job_id") @db.Uuid
  catalogName    String   @map("catalog_name")
  productsJson   Json     @map("products_json")
  seoSummaryJson Json?    @map("seo_summary_json")
  createdAt      DateTime @default(now()) @map("created_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("product_catalogs")
}

model MembershipPlan {
  id             String   @id @default(uuid()) @db.Uuid
  projectId      String   @map("project_id") @db.Uuid
  jobId          String?  @map("job_id") @db.Uuid
  planName       String   @map("plan_name")
  plansJson      Json     @map("plans_json")
  onboardingJson Json?    @map("onboarding_json")
  createdAt      DateTime @default(now()) @map("created_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("membership_plans")
}