# ── Supabase (DB + Auth + Storage) ────────────────────────────────────────────
# Connection pooler URL (used by Prisma in production via PgBouncer)
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection URL (used by Prisma for migrations)
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Supabase project credentials — Settings > API
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Storage bucket names (create these in Supabase Storage)
SUPABASE_STORAGE_BUCKET="agent-assets"
SUPABASE_ASSETS_BUCKET="generated-assets"

# ── Next.js (Vercel — apps/web) ────────────────────────────────────────────────
# Set to your Railway API service public URL after deploying
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ── AI Providers (Railway API + Worker) ───────────────────────────────────────
OPENAI_API_KEY="sk-..."
FAL_KEY="your-fal-key"
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Feature flags
PAID_MEDIA_ENABLE_MOCKUPS="false"
FAL_PAID_MEDIA_MODEL_URL="https://fal.run/fal-ai/flux/schnell"

# ── App URLs ──────────────────────────────────────────────────────────────────
# Set to your Vercel deployment URL in production
APP_URL="http://localhost:3000"

# ── Service ports (local dev only — Railway/Vercel assign ports automatically) ─
API_PORT="4000"
WEB_PORT="3000"
WORKER_PORT="4100"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"

# ── pg-boss queue ─────────────────────────────────────────────────────────────
PG_BOSS_SCHEMA="pgboss"
PG_BOSS_JOB_NAME="project-job"
